{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$HOME/dev/FLOPS}/.claude/hooks/session-base.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$HOME/dev/FLOPS}/.claude/hooks/check-handoff.sh\"",
            "timeout": 15,
            "statusMessage": "Checking HANDOFF.md is current"
          }
        ]
      }
    ]
  }
}
