# Copy to client/e2e/.env.local and customize (or export in shell before verify)

# --- Target ---
# FLOPS_BASE_URL=http://localhost:5173
# FLOPS_API_BASE=http://localhost:3001
# FLOPS_E2E_EXTERNAL=0

# Production example:
# FLOPS_BASE_URL=https://www.useflops.com
# FLOPS_API_BASE=https://www.useflops.com
# FLOPS_E2E_EXTERNAL=1
# FLOPS_E2E_TOKEN=paste flops_auth_token from browser DevTools → Application → Local Storage

# --- Thresholds (optional) ---
# FLOPS_LAYOUT_MACROS_MAX_HEIGHT=280
# FLOPS_LAYOUT_MIN_DRAG_DELTA=20
# FLOPS_LAYOUT_MAX_H_SCROLL=4

# --- Viewport filter (optional) ---
# FLOPS_VERIFY_DESKTOP_ONLY=1
# FLOPS_VERIFY_MOBILE_ONLY=1
# FLOPS_VERIFY_VIDEO=1
