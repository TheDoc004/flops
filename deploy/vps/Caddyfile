# /etc/caddy/Caddyfile — HTTPS front for the FLOPS API (certificate via Let's Encrypt, automatic)
api.useflops.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:10000
	log {
		output file /var/log/caddy/flops-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Never write credentials to disk (Caddy only redacts Authorization/Cookie by default).
		format filter {
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>headers>Cookie delete
		}
	}
}
