# Copy this file to `server/.env` and fill in keys. Never commit `.env`.

# --- AI Macro Logger (server-side only) ---
# Set EITHER OpenAI OR Anthropic. If both are set, AI_PROVIDER decides.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_PROVIDER=openai
# AI_MONTHLY_CAP=200

# --- Server ---
# PORT=3001
# DB_PATH=./nutrition.db

# Exact browser origin(s) allowed in production (comma-separated, no trailing slash).
# Example: https://flops.vercel.app
# ALLOWED_ORIGIN=

# --- Email OTP (required in production) ---
# Recommended: Resend (https://resend.com) — create an API key, then:
# RESEND_API_KEY=re_xxxxxxxx
# Optional from-address (default works for Resend test sends to your account email):
# MAIL_FROM=FLOPS <onboarding@resend.dev>
# With a verified domain: MAIL_FROM=FLOPS <login@yourdomain.com>
#
# Alternative: any SMTP URL (including Resend SMTP):
# SMTP_URL=smtp://resend:re_xxxxxxxx@smtp.resend.com:587

# Local / test only — returns OTP in API JSON and enables Apple stub sign-in.
# Never set AUTH_DEV=1 on Render/production.
# AUTH_DEV=1

# Future Capacitor / App Store — Apple Sign In client id for JWT verify.
# APPLE_CLIENT_ID=
