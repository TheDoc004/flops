# Copy this file to `server/.env` and fill in a key. The AI Macro Logger is
# provider-agnostic: set EITHER an OpenAI key OR an Anthropic key. If both are
# set, AI_PROVIDER (or OpenAI by default) decides which is used.
#
# The key is read server-side only and is never sent to the frontend.

# --- Option A: OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Option B: Anthropic Claude ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: force a provider when more than one key is set ("openai" | "anthropic")
# AI_PROVIDER=

# --- Existing server config (optional) ---
# PORT=3001
# DB_PATH=./nutrition.db
# ALLOWED_ORIGIN=
